{
  "$comment": "Knobs for the review bot. Maintainers can change most of these with commands (/ban, /limit, /lock...); otherwise edit via a PR.",
  "maintainers": [],
  "sitesOrg": "awesomeprojects-sites",
  "bannedUsers": [],
  "limits": {},
  "maxPerOwner": 3,
  "maxFilesPerRequest": 10,
  "rejectAccountsYoungerThanDays": 0,
  "holdAccountsYoungerThanDays": 30,
  "holdBotScoreAtLeast": 3,
  "holdNamesContaining": [
    "login",
    "signin",
    "verify",
    "verification",
    "secure",
    "account",
    "wallet",
    "crypto",
    "airdrop",
    "bank",
    "paypal",
    "apple",
    "google",
    "microsoft",
    "github",
    "discord",
    "steam",
    "roblox",
    "netflix",
    "support",
    "official",
    "update",
    "recovery",
    "password",
    "gift"
  ],
  "autoMerge": false,
  "autoMergeMinAccountAgeDays": 180,
  "closeNeedsChangesAfterDays": 14,
  "consentTimeoutDays": 30,
  "locked": false
}
