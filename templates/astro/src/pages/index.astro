---
const title = '{{name}}';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>This is <b>{{host}}</b>, an Astro site by <a href="https://github.com/{{owner}}">@{{owner}}</a>.</p>
      <p>Add pages in <code>src/pages/</code> and push.</p>
    </main>
  </body>
</html>
<style>
  :global(body) { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: ui-sans-serif, system-ui, sans-serif; background: linear-gradient(160deg, #0b1020, #16123a 55%, #2a0f3d); color: #e6ebff; }
  main { padding: 2rem; max-width: 40rem; }
  h1 { font: 800 clamp(2rem, 6vw, 3.4rem)/1.05 ui-monospace, Menlo, monospace; margin: 0 0 1rem; background: linear-gradient(90deg, #7cf7d4, #7aa8ff 50%, #ff7ad9); -webkit-background-clip: text; background-clip: text; color: transparent; }
  a { color: #7aa8ff; }
</style>
